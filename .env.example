# Supabase project URL, e.g. https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Supabase publishable key, e.g. sb_publishable_… (Project Settings -> API Keys).
# This key is public by design and is safe in the browser: RLS decides what it
# may read or write. Never put the service_role key in this file.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
